# Environment variables for Body Sim Learner AI Backend

# Model Configuration
MODEL_PATH=models/bmnet.pth
DEVICE=auto

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Body Sim Learner AI

# Image Processing
IMAGE_SIZE=[224,224]
MAX_IMAGE_SIZE=10485760

# Directories
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Database Configuration
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:123456@localhost:5432/my_measurements_db